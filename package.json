{
  "name": "root",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.0",
      "onFail": "error"
    }
  },
  "description": "",
  "scripts": {
    "lint": "eslint . --ext .ts,.js --ignore-path .gitignore --ignore-pattern apps/web-ui/",
    "versionup": "lerna version",
    "versionup:patch": "lerna version patch",
    "versionup:minor": "lerna version minor",
    "versionup:major": "lerna version major",
    "versionup:rc": "lerna version prerelease --preid rc",
    "versionup:patch-rc": "lerna version prepatch --preid rc",
    "versionup:minor-rc": "lerna version preminor --preid rc",
    "versionup:major-rc": "lerna version premajor --preid rc",
    "build": "lerna run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*",
    "catalogs/*",
    "plugins/**"
  ],
  "dependencies": {
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.55.0",
    "eslint-plugin-neverthrow": "^1.1.4",
    "eslint-plugin-vitest": "^0.3.20",
    "lerna": "10.1.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "nx": {
      "undici": "7.30.1"
    }
  }
}
