{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.11.0",
  "packages": [
    "packages/*",
    "catalogs/*",
    "plugins/*"
  ],
  "useNx": false,
  "rejectCycles": true,
  "command": {
    "version": {
      "forcePublish": true,
      "gitTagVersion": false,
      "push": false,
      "ignoreScripts": true
    }
  }
}